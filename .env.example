# Settings for the contact form. To use them:
#   1. Copy this file to a new file named .env.local (same folder).
#   2. Fill in the values there.
# .env.local is ignored by git, so your key is never committed.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where messages are delivered. Defaults to the email in src/content/profile.ts.
# On Resend's free test sender this must be the address your Resend account uses.
CONTACT_TO_EMAIL=

# Optional. The "from" address. Leave empty to use Resend's shared test sender.
# Set it only after verifying your own domain with Resend, e.g. Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
